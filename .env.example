# ── keys ──────────────────────────────────────────────────────────────────
# Groq free tier caps tokens PER KEY, PER MODEL, PER DAY (200k). Several free
# keys therefore multiply the budget: ForgeAI rotates them and fails over per
# (key, model), so exhausting gpt-oss-20b on one key leaves every other
# combination untouched.
#
# Either a comma-separated list…
FORGEAI_API_KEYS=gsk_key_one,gsk_key_two,gsk_key_three

# …or numbered variants, which are easier to paste one per line.
# FORGEAI_API_KEY=gsk_key_one
# FORGEAI_API_KEY_2=gsk_key_two
# FORGEAI_API_KEY_3=gsk_key_three

FORGEAI_BASE_URL=https://api.groq.com/openai/v1

# ── models ────────────────────────────────────────────────────────────────
# Stages are spread across models because caps are per model: this multiplies
# the budget again. The judge MUST differ from the agent - that is the
# self-preference defense, not an optimisation.
FORGEAI_GEN_MODEL=openai/gpt-oss-20b
FORGEAI_EVALGEN_MODEL=openai/gpt-oss-20b
FORGEAI_AGENT_MODEL=openai/gpt-oss-120b
FORGEAI_JUDGE_MODEL=qwen/qwen3.8-27b

# ── budget ────────────────────────────────────────────────────────────────
# Running out is a normal, reported outcome. `forgeai budget --docs <folder>`
# estimates a run per model before you spend anything.
FORGEAI_MAX_TOKENS=500000
FORGEAI_MAX_SECONDS=2400
FORGEAI_MAX_ITERATIONS=3
FORGEAI_CONCURRENCY=3
