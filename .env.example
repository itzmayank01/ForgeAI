# Groq - free tier, OpenAI-compatible, ~500 tok/s. https://console.groq.com
FORGEAI_API_KEY=gsk_your_key_here
FORGEAI_BASE_URL=https://api.groq.com/openai/v1

# Two DIFFERENT small open families: defeats judge self-preference bias.
FORGEAI_GEN_MODEL=openai/gpt-oss-20b
FORGEAI_JUDGE_MODEL=qwen/qwen3.8-27b

# Budget caps - running out is a normal, reported outcome.
FORGEAI_MAX_TOKENS=500000
FORGEAI_MAX_SECONDS=900
FORGEAI_MAX_ITERATIONS=3
